.{
    .name = .koral,
    .version = "0.0.1",
    .fingerprint = 0x24129dbf897076e5,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The Silo (.silo) export wrapper: builds LLNL Silo 4.12 from source
        // (PDB driver, no HDF5) and exposes a `silo` module. Marked lazy so a
        // plain `zig build test` (no -Dsilo) never touches it or its fetched
        // Silo source — only `-Dsilo` pulls it in (see build.zig).
        .silo = .{ .path = "../silo-zig", .lazy = true },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "koral",
    },
}
